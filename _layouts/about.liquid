---
layout: default
title: "About"
---

<div class="post">
  {% capture full_name %}{% if site.title == 'blank' %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% else %}{{ site.title }}{% endif %}{% endcapture %}
  <header class="post-header">
    <h1 class="post-title" data-text="{{ full_name | strip }}">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{% if page.subtitle %}{{ page.subtitle }}{% else %}AI &nbsp;//&nbsp; Computer Vision &nbsp;//&nbsp; Healthcare{% endif %}</p>
  </header>

  <article>
    {% if site.profile %}
      <div class="profile float-{% if site.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if site.profile.image %}
          {% assign profile_image_path = site.url | append: site.baseurl | append: '/assets/img/' | append: site.profile.image %}
          {% if site.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          <img src="{{ profile_image_path }}" class="{{ profile_image_class }}" alt="Profile Picture" sizes="{{ sizes }}">
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>News</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <div class="about-main-sections">
    <!-- Selected Publications -->
    <div>
      <h2>Selected Publications</h2>

      <div class="pub-item">
        <img src="{{ '/assets/img/monomsk_overview.png' | relative_url }}" alt="MonoMSK publication" class="pub-thumb">
        <div class="pub-content">
          <p><strong>Koleini, F.</strong>, Xue, H., Helmy, A., &amp; Wang, P. (2025). <a href="https://arxiv.org/abs/2511.19326" target="_blank">MonoMSK: Monocular 3D Musculoskeletal Dynamics Estimation</a>. <em>arXiv preprint arXiv:2511.19326.</em></p>
        </div>
      </div>

      <div class="pub-item">
        <img src="{{ '/assets/img/image4.png' | relative_url }}" alt="BioPose publication" class="pub-thumb">
        <div class="pub-content">
          <p><strong>Koleini, F.</strong>, Saleem, M. U., Wang, P., Xue, H., Helmy, A., &amp; Fenwick, A. (2025, February). <a href="https://ieeexplore.ieee.org/abstract/document/10943363" target="_blank">BioPose: Biomechanically-accurate 3D Pose Estimation from Monocular Videos</a>. In <em>2025 IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)</em> (pp. 6330&ndash;6339). IEEE.</p>
        </div>
      </div>

    </div>

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
    </div>
  </article>
</div>
